#it can be any key, does not have to be openai. just the name OPENAI_API_KEY is what openAI's chat completions template looks for.
OPENAI_API_KEY=your_openai_api_key_here
# Leave blank for real OpenAI, or set a compatible provider:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_BASE_URL=https://api.mistral.ai/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL
NOVA_MODEL=openai/gpt-oss-20b


#Model List: openai/gpt-oss-20b, openai/gpt-oss-120b
NOVA_FALLBACK_MODEL=

TAVILY_API_KEY=
OPENWEATHER_API_KEY=your_openweather_api_key_here
GNEWS_API_KEY=your_gnews_api_key_here
NOVA_CHROMA_PATH=./chroma_db